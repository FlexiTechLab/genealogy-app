# Stage 1: Development
FROM node:24-alpine3.23

WORKDIR /app

# Copy only package definition files to leverage Docker layer caching
COPY apps/web-pwa/package*.json ./

# Install dependencies (this layer will only re-run if package.json changes)
RUN npm install

# Full code COPY is optional here if using volumes in docker-compose,
# but recommended as a fallback or template
COPY apps/web-pwa .

EXPOSE 3000

ENV NODE_ENV=development
# Essential for Windows/WSL2 to properly detect file changes (hot reload)
ENV WATCHPACK_POLLING=true 

CMD ["npm", "run", "dev"]